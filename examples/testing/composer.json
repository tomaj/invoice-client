{
    "name": "example/invoice-client-testing",
    "description": "Test code that uses InvoiceApi without the network: TestTransport and Guzzle MockHandler",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "tomaj/invoice-client": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
