{
  "name": "tomaj/invoice-client",
  "description": "Invoice client",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Tomas Majer",
      "homepage": "http://tomaj.sk"
    }
  ],
  "require": {
    "php": "^8.3",
    "guzzlehttp/guzzle": "^7.9 || ^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.90",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-phpunit": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "classmap": [
      "tests/"
    ]
  },
  "scripts": {
    "check": [
      "@phpcs",
      "@phpstan",
      "@test"
    ],
    "cs-fix": "php-cs-fixer fix",
    "phpcs": "php-cs-fixer fix --dry-run --diff --verbose",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "phpunit": [
      "@putenv XDEBUG_MODE=off",
      "phpunit --no-coverage"
    ],
    "test": "@phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
